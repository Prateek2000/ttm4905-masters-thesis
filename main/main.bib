@article{chen_easycrypt_2025,
  title        = {{EasyCrypt} vs. Domino: A comparative study based on the {IEEE} 802.11 4-Way Handshake protocol},
  url          = {https://aaltodoc.aalto.fi/handle/123456789/142257},
  shorttitle   = {{EasyCrypt} vs. Domino},
  abstract     = {This thesis compares two formal verification tools for cryptographic proofs, {EasyCrypt} and Domino, and explores the feasibility of translating formal proofs from Domino into {EasyCrypt}. We first consider a toy example showing via reduction that a (standard) pseudorandom function ({PRF}) with adversarially chosen inputs is also a weak {PRF} where inputs are chosen uniformly at random. This proof combines a reduction step and a probabilistic argument. We formalize this proof in {EasyCrypt} and compare it to a Domino proof. One key difference between the tools is that {EasyCrypt} can prove probabilistic arguments such as the birthday bound, while Domino needs to assume them. We then move to studying the {IEEE} 802.11 4-Way Handshake (4WHS) protocol. Brzuska and Jacobsen ({PKC} 2017) provided a pen-and-paper proof of 4WHS security which was later refined and formalized in Domino by Brzuska, Egger, Rajabi and Winkelmann ({GitHub} domino-lang/domino) in two versions, a full proof and a simplified proof which only established key indistinguishability. We translate part of the key indistinguishability proof from Domino into {EasyCrypt}. Along the way, we develop a systematic approach to translate game-terminating aborts in Domino into aborts in {EasyCrypt} which do not terminate games. Moreover, we develop transformations to move intermediate returns in Domino into a final return statement in {EasyCrypt}. Domino applies similar transforms when compiling to {SMT}-{LIB} code, while the user-facing code allows for intermediate returns. The translation shows the potential of a hybrid approach that combines both tools and leverages the strengths of each, namely using Domino for large-scale verification through its modular structure and automated proof workflow, and {EasyCrypt} for proving probabilistic assumptions.},
  journaltitle = {Master thesis, Aalto University},
  author       = {Chen, Jiaqi},
  urldate      = {2026-07-23},
  date         = {2025-12-31},
  langid       = {english}
}


