theorem freexor {
    const n: Integer; /* secpar */
    const m: Integer; /* message length */
    const enc: fn Bits(n), Bits(n), Bits(n) -> Bits(m); /*NOTE: message is length n for our purposes maybe, since wire labels without pnp are length n */
    const xor_: fn Bits(n), Bits(n) -> Bits(n);

    instance GLINRKKDM0 = GLINRKKDM {
        params {
            n: n,
            m: m,
            enc: enc,
            b: false,
            xor_: xor_,
        }
    }

    instance GLINRKKDM1 = GLINRKKDM {
        params {
            n: n,
            m: m,
            enc: enc,
            b: true,
            xor_: xor_,
        }
    }

    instance RcompGLINRKKDM0 = RcompGLINRKKDM {
        params {
            n: n,
            m: m,
            enc: enc,
            b: false,
            xor_: xor_
        }
    }

    instance RcompGLINRKKDM1 = RcompGLINRKKDM {
        params {
            n: n,
            m: m,
            enc: enc,
            b: true,
            xor_: xor_
        }
    }

    instance GSimFreeXORIdeal = GSimFreeXORIdeal {
        params {
            n: n,
            m: m,
            enc: enc,
            xor_: xor_
        }
    }

    assumptions {
        lin_rk_kdm: GLINRKKDM0 ~ GLINRKKDM1 /*Under the LPN assumption*/
    }

    gamehops {

        reduction RcompGLINRKKDM0 RcompGLINRKKDM1 {
            assumption lin_rk_kdm

            map GLINRKKDM0 RcompGLINRKKDM0 {
                GLINRKKDM: GLINRKKDM
            }

            map GLINRKKDM1 RcompGLINRKKDM1 {
                GLINRKKDM: GLINRKKDM
            }
        }


        equivalence RcompGLINRKKDM1 GSimFreeXORIdeal {
            GARBLE: {
                invariant: [
                    ./theorem/invariants/freexorideal.smt2
                ]

                lemmas {
                    invariant: [no-abort]
                    equal-aborts: []
                    same-output: [no-abort]
                }
            }
        }


        
    }
}