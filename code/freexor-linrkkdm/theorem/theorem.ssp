theorem freexor {
    const n: Integer; /* secpar */
    const m: Integer; /* message length */
    const enc: fn Bits(n), Bits(n), Bits(n) -> Bits(m); /*NOTE: message is length n for our purposes maybe, since wire labels without pnp are length n */
    const xor_: fn Bits(n), Bits(n) -> Bits(n);

    instance G_LIN_RK_KDM0 = G_LIN_RK_KDM {
        params {
            n: n,
            m: m,
            enc: enc,
            b: false,
            xor_: xor_,
        }
    }

    instance G_LIN_RK_KDM1 = G_LIN_RK_KDM {
        params {
            n: n,
            m: m,
            enc: enc,
            b: true,
            xor_: xor_,
        }
    }

    instance R_comp_G_LIN_RK_KDM0 = R_comp_G_LIN_RK_KDM {
        params {
            n: n,
            m: m,
            enc: enc,
            b: false,
            xor_: xor_
        }
    }

    instance R_comp_G_LIN_RK_KDM1 = R_comp_G_LIN_RK_KDM {
        params {
            n: n,
            m: m,
            enc: enc,
            b: true,
            xor_: xor_
        }
    }

    instance G_Sim_FreeXORReal = G_Sim_FreeXORReal {
        params {
            n: n,
            m: m,
            enc: enc,
            xor_: xor_
        }
    }

    instance G_Sim_FreeXORIdeal = G_Sim_FreeXORIdeal {
        params {
            n: n,
            m: m,
            enc: enc,
            xor_: xor_
        }
    }

    assumptions {
        linrkkdm: G_LIN_RK_KDM0 ~ G_LIN_RK_KDM1 /*Under the LPN assumption*/
    }

    gamehops {
        equivalence R_comp_G_LIN_RK_KDM0 G_Sim_FreeXORReal {
            GARBLE: {
                invariant: [
                    ./theorem/real_game_invariant.smt2
                ]

                lemmas {
                    same-output: [no-abort]
                    equal-aborts: []
                    invariant: [no-abort]
                }
            }
        }

        /* equivalence R_comp_G_LIN_RK_KDM0 G_Sim_FreeXORReal {
            GARBLE: {
                invariant: [
                    ./theorem/ideal_game_invariant.smt2
                ]

                lemmas {
                    same-output: [no-abort]
                    equal-aborts: []
                    invariant: [no-abort]
                }
            }
        } */


        reduction R_comp_G_LIN_RK_KDM0 R_comp_G_LIN_RK_KDM1 {
            assumption linrkkdm

            map G_LIN_RK_KDM0 R_comp_G_LIN_RK_KDM0 {
                G_LIN_RK_KDM: G_LIN_RK_KDM
            }

            map G_LIN_RK_KDM1 R_comp_G_LIN_RK_KDM1 {
                G_LIN_RK_KDM: G_LIN_RK_KDM
            }
        }
    }
}