theorem freexor {
    const n: Integer; /* secpar */
    /* const m: Integer;  message length */
    const enc: fn Bits(n), Bits(n) -> Bits(n); /*NOTE: message is length n for our purposes maybe, since wire labels without pnp are length n */
    const zeros: Bits(n); /*placeholder for a zero bitstring message*/
    const xor_: fn Bits(n), Bits(n) -> Bits(n);

    instance G_LIN_RK_KDM0 = G_LIN_RK_KDM {
        params {
            n: n,
            /* m: m, */
            enc: enc,
            zeros: zeros,
            b: false,
            xor_: xor_,
        }
    }

    instance G_LIN_RK_KDM1 = G_LIN_RK_KDM {
        params {
            n: n,
            /* m: m, */
            enc: enc,
            zeros: zeros,
            b: true,
            xor_: xor_,
        }
    }

    assumptions {
        linrkkdm: G_LIN_RK_KDM0 ~ G_LIN_RK_KDM1 /*Under the LPN assumption*/
    }
}