composition GSimFreeXORIdeal {
        const n: Integer; /* secpar */
        const m: Integer;  /* message length */
        const enc: fn Bits(n), Bits(n), Bits(n) -> Bits(m); /*NOTE: message is length n for our purposes maybe, since wire labels without pnp are length n */
        const xor_: fn Bits(n), Bits(n) -> Bits(n);

    instance SimFreeXOR0 = SimFreeXORIdealANDONLY {
        params {
            n: n,
            m:m,
            enc: enc,
            xor_:xor_,
        }
    }

    compose {
        adversary: {
            GARBLE: SimFreeXOR0,
        }
    }
}