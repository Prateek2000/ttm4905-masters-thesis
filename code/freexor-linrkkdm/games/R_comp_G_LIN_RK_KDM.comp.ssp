composition R_comp_G_LIN_RK_KDM {
        const n: Integer; /* secpar */
        const m: Integer;  /* message length */
        const enc: fn Bits(n), Bits(n) -> Bits(n); /*NOTE: message is length n for our purposes maybe, since wire labels without pnp are length n */
        const b: Bool; /* switch for real and ideal behaviour of ENC*/
        const xor_: fn Bits(n), Bits(n) -> Bits(n);

    instance G_LIN_RK_KDM = LIN_RK_KDM {
        params {
            n: n,
            m:m,
            enc: enc,
            b: b,
            xor_:xor_,
        }
    }
    instance R = R {
        params {
            n: n,
            m: m,
            enc: enc,
            xor_:xor_,
        }
    }

    compose {
        adversary: {
            Garble: R,
        },
        R: {
            ENC: G_LIN_RK_KDM,
        }
    }
}