package Sim_FreeXOR_Ideal_ANDONLY {
    params {
        n: Integer, /* secpar */
        m: Integer,  /* message length */
        enc: fn Bits(n), Bits(n), Bits(n) -> Bits(m), /*DISCUSS: message/ct is length n for our purposes maybe, since wire labels without pnp are length n */
        xor_: fn Bits(n), Bits(n) -> Bits(n),

    }
    /*since we dont model the adversary, we dont need to model what is G-Sim-FreeXOR0 or 1 on paper */
    /*we just need to have two games that return Gbl and Sim outputs and */
    /*prove them computationally indistinguishable */
    /*G-Sim-FreeXOR is basically the distinguishing adversary*/

    /* Do i need to split the second return arg into a and b here itself? */
    oracle GARBLE(y: Bool, topo_F: Bits(*)) -> (((Bits(m),Bits(m)),(Bits(m),Bits(m)),(Bits(m),Bits(m)),(Bits(m),Bits(m))),(Bits(n),Bits(n)),Table(Bits(n),Bool))
    /* F: AND gate, x[0]=A, x[1]=B || Bits(*) -> Garbled Table (4*2n here), garbled Inputs(2n here), decoder */
    {
        /* c <- solve(F,x); This was done in the if else blocks*/
        delta <-$ Bits(n) sample-name delta;
        A_0 <-$ Bits(n) sample-name A_0;
        B_0 <-$ Bits(n) sample-name B_0;
        C_0 <-$ Bits(n) sample-name C_0;
        A_1 <- xor_(A_0, delta);
        B_1 <- xor_(B_0, delta);
        C_1 <- xor_(C_0, delta);
        
        R_00 <-$ Bits(n) sample-name R_00; /* row 0 randomness */
        R_01 <-$ Bits(n) sample-name R_01; /* row 1 randomness */
        R_10 <-$ Bits(n) sample-name R_10; /* row 2 randomness */
        R_11 <-$ Bits(n) sample-name R_11; /* row 3 randomness */

        d <- new Table(Bits(n),Bool);
        c <- y;
        
        /* Active row */
        /* a,b */
        r <-$ Bits(n);
        r1 <-$ Bits(n);
        GarbledRow0 <- (enc(A_0, R_00, r), enc(B_0, xor_(R_00, C_0), r1));
        
        /* Inactive rows */
        /* a,b+1 */
        r <-$ Bits(n);
        r1 <-$ Bits(n);
        GarbledRow1 <- (enc(A_0, R_01, r), enc(B_1, 0_n, r1));
        /* a+1,b */
        r <-$ Bits(n);
        r1 <-$ Bits(n);
        GarbledRow2 <- (enc(A_1, 0_n, r), enc(B_0, R_10, r1));
        /* a+1,b+1 */
        r <-$ Bits(n);
        r1 <-$ Bits(n);
        GarbledRow3 <- (enc(A_1, 0_n, r), enc(B_1, 0_n, r1));
        C_ <- (GarbledRow0, GarbledRow1, GarbledRow2, GarbledRow3);
        X_ <- (A_0, B_0);
        d[C_0] <- Some(c);

        
        return (C_,X_,d);
    }
}