package Sim_FreeXOR_Real_ANDONLY {
    params {
        n: Integer, /* secpar */
        /* m: Integer,  message length */
        b: Bool, /* switch for real and ideal behaviour of Sim*/
        solve: fn Bits(*), Bits(*) -> Bool,
        enc: fn Bits(n), Bits(n) -> Bits(n), /*DISCUSS: message/ct is length n for our purposes maybe, since wire labels without pnp are length n */
        xor_: fn Bits(n), Bits(n) -> Bits(n),

    }
    /*since we dont model the adversary, we dont need to model what is G-Sim-FreeXOR0 or 1 on paper */
    /*we just need to have two games that return Gbl and Sim outputs and */
    /*prove them computationally indistinguishable */
    /*G-Sim-FreeXOR is basically the distinguishing adversary*/

    import oracles {
        ENC(key: Bits(n), msg: Bits(n), z: Bool) -> Bits(n),
    }

    oracle Garble(F: Bits(*), x: (Bool, Bool)) -> (Bits(*), (((Bits(n), Bits(n)),(Bits(n), Bits(n)),(Bits(n), Bits(n)),(Bits(n), Bits(n))), Bits(n)), Table(Bits(n), Bool)) 
    /* F: AND gate, x[0]=A, x[1]=B || Bits(*) -> Garbled Table (4n here), garbled Inputs(2n here), decoder */
    {
        /* c <- solve(F,x); This was done in the if else blocks*/
        a <- x[0];
        b <- x[1];
        R_00 <-$ Bits(n) sample-name R_00; /* row 0 randomness */
        R_01 <-$ Bits(n) sample-name R_01; /* row 1 randomness */
        R_10 <-$ Bits(n) sample-name R_10; /* row 2 randomness */
        R_11 <-$ Bits(n) sample-name R_11; /* row 3 randomness */

        C_ <- ((Bits(n), Bits(n)),(Bits(n), Bits(n)),(Bits(n), Bits(n)),(Bits(n), Bits(n))); /* garbled table */
        
        if (a==false and b==false ) {
            c <- false; /* AND gate */
            A_0 <-$ Bits(n) sample-name A_0;
            B_0 <-$ Bits(n) sample-name B_0;
            C_0 <-$ Bits(n) sample-name C_0;
            /* This function does not have access to the circuit offset lambda and must use the oracle ENC call*/

            /*z = (c + op(rowidx_bit1,rowidx_bit2))*/
            /* Active row */
            /* a,b */
            C_[0] <- (enc(A_0, R_00), enc(B_0, xor_(R_00, C_0)));
            
            /* Inactive rows */
            /* a,b+1 */
            C_[1] <- (enc(A_0, R_01), invoke ENC(B_0, xor_(R_01, C_0), false));
            /* a+1,b */
            C_[2] <- (invoke ENC(A_0, xor_(R_10, C_0), false), enc(B_0, R_10)); /*The weird part 1 part 2 flip ind thing we need to prove*/
            /*C_[2] is comp-ind from enc(A_0+s, R_10),enc(B_0, xor_(R_10,C_0))*/
            /* a+1,b+1 */
            C_[3] <- (invoke ENC(A_0, R_11, 0), invoke ENC(B_0, xor_(R_11, C_1), 0));


        } else if (a==false and b==true) {
            c <- false; /* AND gate */
            A_0 <-$ Bits(n) sample-name A_0;
            B_1 <-$ Bits(n) sample-name B_1;
            C_0 <-$ Bits(n) sample-name C_0;
            /* This function does not have access to the circuit offset lambda and must use the oracle ENC call*/
            /*z = (c + op(rowidx_bit1,rowidx_bit2))*/
            /* Active row */
             /* a,b */
            C_[1] <- (enc(A_0, R_01), enc(B_1, xor_(R_01, C_0)));

            /* Inactive rows */
            /* a,b+1 */
            C_[0] <- (enc(A_0, R_00), invoke ENC(B_1, xor_(R_00, C_0), false));
            /* a+1,b */
            C_[3] <- (invoke ENC(A_0, xor_(R_11, C_1), true /*im so lost on calculating z when we dont have general a,b*/), enc(B_1, R_11)); /*The weird part 1 part 2 flip ind thing we need to prove*/
            /*C_[3] is comp-ind from enc(A_0+s, R_10),enc(B_0, xor_(R_10,C_0))*/
            /* a+1,b+1 */
            C_[2] <- (invoke ENC(A_0, R_10, False), invoke ENC(B_0, xor_(R_10, C_0), 0));
        } else if (a==true and b==false) {
            
        } else {

        }
    }
}