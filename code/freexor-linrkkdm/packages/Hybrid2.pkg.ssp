package Hybrid2 {
    params {
        n: Integer, /* secpar */
        m: Integer,  /* message length */
        enc: fn Bits(n), Bits(n), Bits(n) -> Bits(m),
        bit: Bool, /* switch for real and ideal behaviour of ENC*/
        xor_: fn Bits(n), Bits(n) -> Bits(n),
    }
    state {
        delta: Maybe(Bits(n)),  /*change it to delta*/
    }
    import oracles {
        ENC(key: Bits(n), msg: Bits(n), z: Bool) -> Bits(m),
    }
    
    /*DISCUSS: the interfaces for real and ideal game are different (f,x) vs (y,topo(f)) -> maybe it needs an outer layer*/
    oracle GARBLEAND(x: (Bool, Bool)) -> 
    (
        (
            (Bits(m), Bits(m)),
            (Bits(m), Bits(m)),
            (Bits(m), Bits(m)),
            (Bits(m), Bits(m))
        ),
        (Bits(n), Bits(n)),
        Table(Bits(n), Bool)
    ) 
    {
        if (delta == None) {
            tmp <-$ Bits(n) sample-name delta;
            delta <- Some(tmp);
        } 
        (a,b) <- x;
        R_00 <-$ Bits(n) sample-name R_00; /* row 0 randomness */
        R_01 <-$ Bits(n) sample-name R_01; /* row 1 randomness */
        R_10 <-$ Bits(n) sample-name R_10; /* row 2 randomness */
        R_11 <-$ Bits(n) sample-name R_11; /* row 3 randomness */

        C_ <- ((0_m, 0_m),(0_m, 0_m),(0_m, 0_m),(0_m, 0_m));
        X_ <- (0_n, 0_n);
        d <- new Table(Bits(n),Bool);

        /*We sample the following in advance since we cannot reuse sample names later*/
        tempsample1 <-$ Bits(n) sample-name A_0;
        tempsample2 <-$ Bits(n) sample-name B_0;
        tempsample3 <-$ Bits(n) sample-name C_0;
        
        r01 <-$ Bits(n) sample-name randrow0enc1;
        r02 <-$ Bits(n) sample-name randrow0enc2;
        r11 <-$ Bits(n) sample-name randrow1enc1;
        r12 <-$ Bits(n) sample-name randrow1enc2;
        r21 <-$ Bits(n) sample-name randrow2enc1;
        r22 <-$ Bits(n) sample-name randrow2enc2;
        r31 <-$ Bits(n) sample-name randrow3enc1;
        r32 <-$ Bits(n) sample-name randrow3enc2;

        if ((a==false) and (b==false)) {
            c <- false; /* AND gate */
            A_0 <-tempsample1;
            B_0 <-tempsample2;
            C_0 <-tempsample3;
            GarbledRow0 <- (0_m, 0_m);
            GarbledRow1 <- (0_m, 0_m);
            GarbledRow2 <- (0_m, 0_m);
            GarbledRow3 <- (0_m, 0_m);

            /*z = (c + op(rowidx_bit1,rowidx_bit2))*/
            /* Active row */
            /* a,b */
            GarbledRow0 <- (enc(A_0, R_00, r01), enc(B_0, xor_(R_00, C_0), r02));
            
            /* Inactive rows */
            /* a,b+1 */
            if bit {
                GarbledRow1 <- (enc(A_0, R_01, r11), enc(xor_(B_0, Unwrap(delta)), 0_n, r12)); 
            } else {
                GarbledRow1 <- (enc(A_0, R_01, r11), enc(xor_(B_0, Unwrap(delta)), xor_(R_01, C_0), r12));
            }
            /* a+1,b */
            if bit {
                GarbledRow2 <- (enc(xor_(A_0, Unwrap(delta)), 0_n, r21), enc(B_0, R_10, r22));
            } else {
                GarbledRow2 <- (enc(xor_(A_0, Unwrap(delta)), xor_(R_10, C_0), r21), enc(B_0, R_10, r22));
            }
            /*C_[2] is comp-ind from enc(A_0+s, R_10),enc(B_0, xor_(R_10,C_0))*/
            /* a+1,b+1 */
            if bit {
                GarbledRow3 <- (enc(xor_(A_0, Unwrap(delta)), 0_n, r31), enc(xor_(B_0, Unwrap(delta)), 0_n, r32));
            } else {
                GarbledRow3 <- (enc(xor_(A_0, Unwrap(delta)), R_11, r31), enc(xor_(B_0, Unwrap(delta)), xor_(xor_(R_11, C_0),Unwrap(delta)), r32));
            }
            C_ <- (GarbledRow0, GarbledRow1, GarbledRow2, GarbledRow3);
            X_ <- (A_0, B_0);
            d[C_0] <- Some(c);

        } 
        if ((a==false) and (b==true)) {
            c <- false; /* AND gate */
            A_0 <-tempsample1;
            B_0 <-tempsample2; 
            B_1 <-xor_(B_0, Unwrap(delta));
            C_0 <-tempsample3;
            /* This function does not have access to the circuit offset lambda and must use the oracle ENC call*/
            /*z = (c + op(rowidx_bit1,rowidx_bit2))*/
            /* Active row */
            /* a,b */
            GarbledRow1 <- (enc(A_0, R_01, r01), enc(B_1, xor_(R_01, C_0), r02));

            /* Inactive rows */
            /* a,b+1 */
            if bit {
                GarbledRow0 <- (enc(A_0, R_00, r11), enc(xor_(B_1, Unwrap(delta)), 0_n, r12));            
            } else {
                GarbledRow0 <- (enc(A_0, R_00, r11), enc(xor_(B_1, Unwrap(delta)), xor_(R_00, C_0), r12));            
            }

            /* a+1,b */
            if bit {
                GarbledRow3 <- (enc(xor_(A_0, Unwrap(delta)), 0_n, r21), enc(B_1, R_11, r22));            
            } else {
                temp <- invoke ENC(A_0, xor_(R_11, C_0), true);
                GarbledRow3 <- (enc(xor_(A_0, Unwrap(delta)), xor_(xor_(R_11, C_0),Unwrap(delta)), r21), enc(B_1, R_11, r22));            
            }

            /*C_[3] is comp-ind from enc(A_0+s, R_10),enc(B_0, xor_(R_10,C_0))*/
            /* a+1,b+1 */
            if bit {
                GarbledRow2 <- (enc(xor_(A_0, Unwrap(delta)), 0_n, r31), enc(xor_(B_1, Unwrap(delta)), 0_n, r32));
            } else {
                GarbledRow2 <- (enc(xor_(A_0, Unwrap(delta)), R_10, r31), enc(xor_(B_1, Unwrap(delta)), xor_(R_10, C_0), r32));          
            }


            C_ <- (GarbledRow0, GarbledRow1, GarbledRow2, GarbledRow3);
            X_ <- (A_0, B_1);
            d[C_0] <- Some(c);

        } 
        if ((a==true) and (b==false)) {
            c <- false; /* AND gate */
            A_0 <-tempsample1;
            B_0 <-tempsample2;
            C_0 <-tempsample3;
            A_1 <- xor_(A_0, Unwrap(delta));
            /* This function does not have access to the circuit offset lambda and must use the oracle ENC call*/
            /*z = (c + op(rowidx_bit1,rowidx_bit2))*/
            /* Active row */
            /* a,b */
            GarbledRow2 <- (enc(A_1, R_10, r01), enc(B_0, xor_(R_10, C_0), r02));

            /* Inactive rows */
            /* a,b+1 */
            if bit {
                GarbledRow3 <- (enc(A_1, R_11, r11), enc(xor_(B_0, Unwrap(delta)), 0_n, r12));
            } else {
                GarbledRow3 <- (enc(A_1, R_11, r11), enc(xor_(B_0, Unwrap(delta)), xor_(xor_(R_11, C_0),Unwrap(delta)), r12));
            }
            /* a+1,b */
            if bit {
                GarbledRow0 <- (enc(xor_(A_1, Unwrap(delta)), 0_n, r21), enc(B_0, R_00, r22));
            } else {
                GarbledRow0 <- (enc(xor_(A_1, Unwrap(delta)), xor_(R_00, C_0), r21), enc(B_0, R_00, r22));
            }
            /*The weird part 1 part 2 flip ind thing we need to prove*/
            /*C_[3] is comp-ind from enc(A_0+s, R_10),enc(B_0, xor_(R_10,C_0))*/
            /* a+1,b+1 */
            if bit {
                temp <- invoke ENC(A_1, R_01, false);
                temp2 <- invoke ENC(B_0, xor_(R_01, C_0), false);
                GarbledRow1 <- (enc(xor_(A_1, Unwrap(delta)), 0_n, r31), enc(xor_(B_0, Unwrap(delta)), 0_n, r32));
            } else {
                temp <- invoke ENC(A_1, R_01, false);
                temp2 <- invoke ENC(B_0, xor_(R_01, C_0), false);
                GarbledRow1 <- (enc(xor_(A_1, Unwrap(delta)), R_01, r31), enc(xor_(B_0, Unwrap(delta)), xor_(R_01, C_0), r32));
            }

            C_ <- (GarbledRow0, GarbledRow1, GarbledRow2, GarbledRow3);
            X_ <- (A_1, B_0);
            d[C_0] <- Some(c);

        }
        if ((a==true) and (b==true)) {
            c <- true; /* AND gate */
            A_0 <-tempsample1;
            B_0 <-tempsample2;
            C_0 <-tempsample3;
            A_1 <-xor_(A_0, Unwrap(delta));
            B_1 <-xor_(B_0, Unwrap(delta));
            C_1 <-xor_(C_0, Unwrap(delta));
            /* This function does not have access to the circuit offset lambda and must use the oracle ENC call*/
            /*z = (c + op(rowidx_bit1,rowidx_bit2))*/
            /* Active row */
            /* a,b */
            GarbledRow3 <- (enc(A_1, R_11, r01), enc(B_1, xor_(R_11, C_1), r02));

            /* Inactive rows */
            /* a,b+1 */
            if bit {
                GarbledRow2 <- (enc(A_1, R_10, r11), enc(xor_(B_1, Unwrap(delta)), 0_n, r12));
            } else {
                GarbledRow2 <- (enc(A_1, R_10, r11), enc(xor_(B_1, Unwrap(delta)), xor_(xor_(R_10, C_1),Unwrap(delta)), r12));
            }
            /* a+1,b */
            if bit {
                GarbledRow1 <- (enc(xor_(A_1, Unwrap(delta)), 0_n, r21), enc(B_1, R_01, r22));
            } else {
                GarbledRow1 <- (enc(xor_(A_1, Unwrap(delta)), xor_(xor_(R_01, C_1),Unwrap(delta)), r21), enc(B_1, R_01, r22));
            }
             /*The weird part 1 part 2 flip ind thing we need to prove*/
            /*C_[3] is comp-ind from enc(A_0+s, R_10),enc(B_0, xor_(R_10,C_0))*/
            /* a+1,b+1 */
            if bit {
                GarbledRow0 <- (enc(xor_(A_1, Unwrap(delta)), 0_n, r31), enc(xor_(B_1, Unwrap(delta)), 0_n, r32));
            } else {
                GarbledRow0 <- (enc(xor_(A_1, Unwrap(delta)), R_00, r31), enc(xor_(B_1, Unwrap(delta)), xor_(xor_(R_00, C_1),Unwrap(delta)), r32));
            }
            C_ <- (GarbledRow0, GarbledRow1, GarbledRow2, GarbledRow3);
            X_ <- (A_1, B_1);
            d[C_1] <- Some(c);
        }
        return (C_,X_,d);
    }
}