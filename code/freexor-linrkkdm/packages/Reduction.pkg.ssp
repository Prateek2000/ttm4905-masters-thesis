package Reduction {
    params {
        n: Integer, /* secpar */
        m: Integer,  /* message length */
        enc: fn Bits(n), Bits(n), Bits(n) -> Bits(m),
        xor_: fn Bits(n), Bits(n) -> Bits(n),
    }
    state {
        called: Bool,
    }
    import oracles {
        ENC(key: Bits(n), msg: Bits(n), z: Bool) -> Bits(m),
    }
    
    /*DISCUSS: the interfaces for real and ideal game are different (f,x) vs (y,topo(f)) -> maybe it needs an outer layer*/
    oracle GARBLEAND(x: (Bool, Bool)) -> 
    (
        (
            (Bits(m), Bits(m)),
            (Bits(m), Bits(m)),
            (Bits(m), Bits(m)),
            (Bits(m), Bits(m))
        ),
        (Bits(n), Bits(n)),
        Table(Bits(n), Bool)
    ) 
    {
        (a,b) <- x;
        R_00 <-$ Bits(n) sample-name R_00; /* row 0 randomness */
        R_01 <-$ Bits(n) sample-name R_01; /* row 1 randomness */
        R_10 <-$ Bits(n) sample-name R_10; /* row 2 randomness */
        R_11 <-$ Bits(n) sample-name R_11; /* row 3 randomness */

        C_ <- ((0_m, 0_m),(0_m, 0_m),(0_m, 0_m),(0_m, 0_m));
        X_ <- (0_n, 0_n);
        d <- new Table(Bits(n),Bool);

        /*We sample the following in advance since we cannot reuse sample names later*/
        tempsample1 <-$ Bits(n) sample-name A_0;
        tempsample2 <-$ Bits(n) sample-name B_0;
        tempsample3 <-$ Bits(n) sample-name C_0;
        
        r01 <-$ Bits(n) sample-name randrow0enc1;
        r02 <-$ Bits(n) sample-name randrow0enc2;
        r11 <-$ Bits(n) sample-name randrow1enc1;
        r22 <-$ Bits(n) sample-name randrow2enc2;

        if ((a==false) and (b==false)) {
            c <- false; /* AND gate */
            A_0 <-tempsample1;
            B_0 <-tempsample2;
            C_0 <-tempsample3;
            /* This function does not have access to the circuit offset lambda and must use the oracle ENC call*/

            /*z = (c + op(rowidx_bit1,rowidx_bit2))*/
            /* Active row */
            /* a,b */
            GarbledRow0 <- (enc(A_0, R_00, r01), enc(B_0, xor_(R_00, C_0), r02));
            
            /* Inactive rows */
            /* a,b+1 */
            temp <- invoke ENC(B_0, xor_(R_01, C_0), false);
            GarbledRow1 <- (enc(A_0, R_01, r11), temp);
            /* a+1,b */
            temp <- invoke ENC(A_0, xor_(R_10, C_0), false);
            GarbledRow2 <- (temp, enc(B_0, R_10, r22)); /*The weird part 1 part 2 flip ind thing we need to prove*/
            /*C_[2] is comp-ind from enc(A_0+s, R_10),enc(B_0, xor_(R_10,C_0))*/
            /* a+1,b+1 */
            temp <- invoke ENC(A_0, R_11, false);
            temp2 <- invoke ENC(B_0, xor_(R_11, C_0), true);
            GarbledRow3 <- (temp, temp2);
            C_ <- (GarbledRow0, GarbledRow1, GarbledRow2, GarbledRow3);
            X_ <- (A_0, B_0);
            d[C_0] <- Some(c);

        } 
        if ((a==false) and (b==true)) {
            c <- false; /* AND gate */
            A_0 <-tempsample1;
            B_1 <-tempsample2; 
            C_0 <-tempsample3;
            /* This function does not have access to the circuit offset lambda and must use the oracle ENC call*/
            /*z = (c + op(rowidx_bit1,rowidx_bit2))*/
            /* Active row */
            /* a,b */
            GarbledRow1 <- (enc(A_0, R_01, r01), enc(B_1, xor_(R_01, C_0), r02));

            /* Inactive rows */
            /* a,b+1 */
            temp <- invoke ENC(B_1, xor_(R_00, C_0), false);
            GarbledRow0 <- (enc(A_0, R_00, r11), temp);
            /* a+1,b */
            temp <- invoke ENC(A_0, xor_(R_11, C_0), true);
            GarbledRow3 <- (temp, enc(B_1, R_11, r22)); /*The weird part 1 part 2 flip ind thing we need to prove*/
            /*C_[3] is comp-ind from enc(A_0+s, R_10),enc(B_0, xor_(R_10,C_0))*/
            /* a+1,b+1 */
            temp <- invoke ENC(A_0, R_10, false);
            temp2 <- invoke ENC(B_1, xor_(R_10, C_0), false);
            GarbledRow2 <- (temp, temp2);

            C_ <- (GarbledRow0, GarbledRow1, GarbledRow2, GarbledRow3);
            X_ <- (A_0, B_1);
            d[C_0] <- Some(c);

        } 
        if ((a==true) and (b==false)) {
            c <- false; /* AND gate */
            A_1 <-tempsample1;
            B_0 <-tempsample2;
            C_0 <-tempsample3;
            /* This function does not have access to the circuit offset lambda and must use the oracle ENC call*/
            /*z = (c + op(rowidx_bit1,rowidx_bit2))*/
            /* Active row */
            /* a,b */
            GarbledRow2 <- (enc(A_1, R_10, r01), enc(B_0, xor_(R_10, C_0), r02));

            /* Inactive rows */
            /* a,b+1 */
            temp <- invoke ENC(B_0, xor_(R_11, C_0), true);
            GarbledRow3 <- (enc(A_1, R_11, r11), temp);
            /* a+1,b */
            temp <- invoke ENC(A_1, xor_(R_00, C_0), false);
            GarbledRow0 <- (temp, enc(B_0, R_00, r22)); /*The weird part 1 part 2 flip ind thing we need to prove*/
            /*C_[3] is comp-ind from enc(A_0+s, R_10),enc(B_0, xor_(R_10,C_0))*/
            /* a+1,b+1 */
            temp <- invoke ENC(A_1, R_01, false);
            temp2 <- invoke ENC(B_0, xor_(R_01, C_0), false);
            GarbledRow1 <- (temp, temp2);

            C_ <- (GarbledRow0, GarbledRow1, GarbledRow2, GarbledRow3);
            X_ <- (A_1, B_0);
            d[C_0] <- Some(c);

        }
        if ((a==true) and (b==true)) {
            c <- true; /* AND gate */
            A_1 <-tempsample1;
            B_1 <-tempsample2;
            C_1 <-tempsample3;
            /* This function does not have access to the circuit offset lambda and must use the oracle ENC call*/
            /*z = (c + op(rowidx_bit1,rowidx_bit2))*/
            /* Active row */
            /* a,b */
            GarbledRow3 <- (enc(A_1, R_11, r01), enc(B_1, xor_(R_11, C_1), r02));

            /* Inactive rows */
            /* a,b+1 */
            temp <- invoke ENC(B_1, xor_(R_10, C_1), true);
            GarbledRow2 <- (enc(A_1, R_10, r11), temp);
            /* a+1,b */
            temp <- invoke ENC(A_1, xor_(R_01, C_1), true);
            GarbledRow1 <- (temp, enc(B_1, R_01, r22)); /*The weird part 1 part 2 flip ind thing we need to prove*/
            /*C_[3] is comp-ind from enc(A_0+s, R_10),enc(B_0, xor_(R_10,C_0))*/
            /* a+1,b+1 */
            temp <- invoke ENC(A_1, R_00, false);
            temp2 <- invoke ENC(B_1, xor_(R_00, C_1), true);
            GarbledRow0 <- (temp, temp2);

            C_ <- (GarbledRow0, GarbledRow1, GarbledRow2, GarbledRow3);
            X_ <- (A_1, B_1);
            d[C_1] <- Some(c);
        }
        return (C_,X_,d);
    }
}